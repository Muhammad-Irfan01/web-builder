# Orcayo Custom Builder — Environment Variables
# Copy to .env and fill in your values

# Backend API base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Multi-tenant store ID injected as x-store-id header on every API request
VITE_STORE_ID=your-store-id-here

# Display name used in UI and storefront
VITE_STORE_NAME=My Orcayo Store
